              "mode": "raw",
              "raw": "{\n  \"email\": \"teacher@sms.com\",\n  \"password\": \"teacher123\",\n  \"fullName\": \"Dr. Jane Doe\",\n  \"role\": \"ROLE_TEACHER\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/auth/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "auth", "register"]
            }
