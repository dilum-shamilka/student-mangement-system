{
  "info": {
    "name": "Student Management System API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },

  "item": [

    {
      "name": "AUTH",

      "item": [

        {
          "name": "Login",

          "request": {

            "method": "POST",

            "header": [
              {
                "key":"Content-Type",
                "value":"application/json"
              }
            ],

            "body":{

              "mode":"raw",

              "raw":"{\n \"email\":\"admin@sliit.edu.lk\",\n \"password\":\"admin123\"\n}"

            },


            "url":{
              "raw":"http://localhost:8080/api/auth/login"
            }

          }

        },


        {
          "name":"Register",

          "request":{

            "method":"POST",

            "header":[
              {
                "key":"Content-Type",
                "value":"application/json"
              }
            ],

            "body":{

              "mode":"raw",

              "raw":"{\n \"fullName\":\"New Admin\",\n \"email\":\"newadmin@gmail.com\",\n \"password\":\"admin123\",\n \"role\":\"ADMIN\"\n}"

            },


            "url":{
              "raw":"http://localhost:8080/api/auth/register"
            }

          }

        }


      ]

    },




    {
      "name":"ADMIN STUDENTS",

      "item":[


        {
          "name":"Get All Students",

          "request":{

            "method":"GET",

            "header":[

              {
                "key":"Authorization",
                "value":"Bearer TOKEN"
              }

            ],


            "url":{
              "raw":"http://localhost:8080/api/admin/students"
            }

          }

        },



        {
          "name":"Create Student",

          "request":{

            "method":"POST",

            "header":[

              {
                "key":"Content-Type",
                "value":"application/json"
              },

              {
                "key":"Authorization",
                "value":"Bearer TOKEN"
              }

            ],


            "body":{

              "mode":"raw",

              "raw":"{\n \"studentIdNumber\":\"STU-2026-100\",\n \"firstName\":\"Saman\",\n \"lastName\":\"Perera\",\n \"email\":\"saman@gmail.com\",\n \"phone\":\"0771234567\",\n \"department\":\"Software Engineering\",\n \"enrollmentDate\":\"2026-08-03\",\n \"status\":\"ACTIVE\"\n}"

            },


            "url":{

              "raw":"http://localhost:8080/api/admin/students"

            }

          }

        }


      ]

    },




    {
      "name":"ADMIN COURSES",

      "item":[


        {

          "name":"Get Courses",

          "request":{

            "method":"GET",

            "header":[

              {
                "key":"Authorization",
                "value":"Bearer TOKEN"
              }

            ],

            "url":{

              "raw":"http://localhost:8080/api/admin/courses"

            }

          }

        }

      ]

    },




    {
      "name":"DASHBOARD",

      "item":[


        {

          "name":"Dashboard Stats",

          "request":{

            "method":"GET",

            "header":[

              {
                "key":"Authorization",
                "value":"Bearer TOKEN"
              }

            ],

            "url":{

              "raw":"http://localhost:8080/api/dashboard/stats"

            }

          }

        }


      ]

    }


  ]

}