{
  "info": {
    "name": "Student Management System API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },

  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    }
  ],

  "item": [

    {
      "name": "AUTH",
      "item": [

        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\":\"admin@sliit.edu.lk\",\n    \"password\":\"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login"
            }
          }
        },


        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstName\":\"New\",\n    \"lastName\":\"Admin\",\n    \"email\":\"newadmin@gmail.com\",\n    \"password\":\"admin123\",\n    \"role\":\"ADMIN\",\n    \"phone\":\"0771234567\",\n    \"dateOfBirth\":\"2000-01-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register"
            }
          }
        }

      ]
    },


    {
      "name": "STUDENTS",
      "item": [

        {
          "name": "Get All Students",
          "request": {
            "method": "GET",
            "header": [
              {
                "key":"Authorization",
                "value":"Bearer {{token}}"
              }
            ],
            "url":{
              "raw":"{{baseUrl}}/api/v1/students"
            }
          }
        },


        {
          "name":"Create Student",
          "request":{
            "method":"POST",
            "header":[
              {
                "key":"Content-Type",
                "value":"application/json"
              },
              {
                "key":"Authorization",
                "value":"Bearer {{token}}"
              }
            ],

            "body":{
              "mode":"raw",
              "raw":"{\n    \"firstName\":\"Saman\",\n    \"lastName\":\"Perera\",\n    \"email\":\"saman@gmail.com\",\n    \"phone\":\"0771234567\",\n    \"dateOfBirth\":\"2002-05-10\",\n    \"enrollmentStatus\":\"ACTIVE\"\n}"
            },

            "url":{
              "raw":"{{baseUrl}}/api/v1/students"
            }
          }
        }

      ]
    },


    {
      "name":"COURSES",
      "item":[

        {
          "name":"Get All Courses",
          "request":{
            "method":"GET",
            "header":[
              {
                "key":"Authorization",
                "value":"Bearer {{token}}"
              }
            ],

            "url":{
              "raw":"{{baseUrl}}/api/v1/courses"
            }
          }
        },


        {
          "name":"Create Course",
          "request":{
            "method":"POST",

            "header":[
              {
                "key":"Content-Type",
                "value":"application/json"
              },
              {
                "key":"Authorization",
                "value":"Bearer {{token}}"
              }
            ],

            "body":{
              "mode":"raw",
              "raw":"{\n    \"courseName\":\"Java Programming\",\n    \"courseCode\":\"JAVA101\",\n    \"description\":\"Java Spring Boot Course\"\n}"
            },

            "url":{
              "raw":"{{baseUrl}}/api/v1/courses"
            }
          }
        }

      ]
    },


    {
      "name":"DASHBOARD",

      "item":[

        {
          "name":"Dashboard Stats",

          "request":{
            "method":"GET",

            "header":[
              {
                "key":"Authorization",
                "value":"Bearer {{token}}"
              }
            ],

            "url":{
              "raw":"{{baseUrl}}/api/v1/dashboard/stats"
            }

          }

        }

      ]

    }

  ]
}